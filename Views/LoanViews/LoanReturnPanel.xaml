<UserControl x:Class="LIBBRARY_MANAGER.Views.LoanViews.LoanReturnPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             mc:Ignorable="d"
             Width="400"
             Background="White"
             x:Name="root">



    <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER (ton rouge d'alerte pour le contexte de retour) -->
            <Border Grid.Row="0"
                    Background="#B71C1C"
                    Padding="20">
                <Grid>
                    <TextBlock Text="Confirmation — Retour de livre"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <items:IconButton x:Name="CloseBtn"
                                      IconKind="Close"
                                      IconSize="20"
                                      IconColor="White"
                                      ButtonColor="Transparent"
                                      ButtonWidth="36"
                                      ButtonHeight="36"
                                      Shape="Circle"
                                      HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- CONTENU (lecture seule) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20">
                <StackPanel>

                    <!-- GRAND CHAMP D'AFFICHAGE DE LA RÉFÉRENCE (readonly, design) -->
                    <TextBlock Text="Référence du prêt"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#B71C1C"
                               Margin="0,0,0,8"/>

                    <Border Background="#FFF3F3"
                            BorderBrush="#FFCDD2"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,18">
                        <!-- grand TextBlock lisible -->
                        <StackPanel Orientation="Vertical" >
                        <TextBlock x:Name="TxtLoanRefLarge"
                                   Text="{Binding SelectedLoan.Ref_Loan}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="#B71C1C"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                            <Border BorderBrush="#CC3333" BorderThickness="2" Height="2" CornerRadius="20"/>
                        </StackPanel>
                    </Border>

                    <!-- Résumé du prêt (readonly) -->
                    <Border Background="#FFEBEE"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,20"
                            Visibility="{Binding SelectedLoan, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedLoan.Book.Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#212121"/>
                            <TextBlock Text="{Binding SelectedLoan.Subscriber.Name_User,StringFormat='Emprunté par :  {0}'}"
                                       FontSize="14"
                                       Foreground="#616161"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedLoan.Ref_Loan,StringFormat='Référence de  l''emprunt :  {0}'}"
                                       FontSize="12"
                                       Foreground="#9E9E9E"
                                       Margin="0,2,0,0"/>

                            <Separator Margin="0,10"/>

                            <TextBlock Text="{Binding SelectedLoan.ReturnDate, StringFormat='Date prévue : {0:dd MMM yyyy}'}"
                                       FontSize="13"
                                       Foreground="#424242"/>
                            <TextBlock Text="{Binding SelectedLoan.DaysLate, StringFormat='Jours de retard : {0}'}"
                                       FontSize="13"
                                       Foreground="{Binding SelectedLoan.IsLate, Converter={StaticResource LoanLateColorConverter}}"/>
                            <TextBlock Text="{Binding SelectedLoan.Penalty, StringFormat='Pénalité : {0:C2}'}"
                                       FontSize="13"
                                       Foreground="{Binding SelectedLoan.Penalty, Converter={StaticResource PenaltyToColorConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Zone d’observation (readonly) -->
                    <TextBlock Text="Remarques "
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B71C1C"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="ReturnNotesBox"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"                             
                             BorderBrush="#FFCDD2"
                             BorderThickness="2"
                             Padding="10"
                             FontSize="14"
                             Text="{Binding SelectedLoan.ReturnNotes, Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER (Confirm / Close) -->
            <Border Grid.Row="2"
                    Background="#FFEBEE"
                    BorderBrush="#FFCDD2"
                    BorderThickness="0,1,0,0"
                    Padding="20">
                <StackPanel>
                    <Button Content="Confirmer le retour"
                            Background="#B71C1C"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Height="45"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ConfirmReturnCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#8E0000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Annuler"
                            Background="Transparent"
                            Foreground="#757575"
                            FontSize="14"
                            Height="40"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
