<UserControl x:Class="LIBBRARY_MANAGER.Views.BookViews.BookGridItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200"
             Height="320"
             Margin="10"
             x:Name="root"
            xmlns:Global='clr-namespace:LIBBRARY_MANAGER.UI.Common.Items'
             Cursor="Hand">

    <UserControl.Resources>
        <!-- 🎨 Style global pour la carte-bouton -->
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{x:Null}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <!-- 📚 Contenu de la carte -->
                            <ContentPresenter/>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="100" CenterY="160"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- ✨ Animations d'état -->
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#1565C0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="#E0E0E0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Click press -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ✅ CORRECTION: Ajouter CommandParameter pour passer le DataContext -->
    <Button Style="{StaticResource CardButtonStyle}"
            Command="{Binding ShowDetailBtnClick, ElementName=root}"
            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Self}}"
            Cursor="Hand"
            BorderThickness="0"
            MouseRightButtonDown="BookGridItem_MouseRightButtonDown"
            Background="White">

        <!-- 💡 Contenu : ton ancien Grid -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Couverture -->
            <Grid Grid.Row="0">
                <Border CornerRadius="8"
                        Background="#F5F5F5"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>
                    </Border.Effect>
                    <Image Source="{Binding DisplayCoverUrl}" Stretch="UniformToFill"/>
                </Border>

                <!-- Statut disponibilité -->
                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding AvailabilityColor}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AvailabilityText}"
                                   FontSize="12"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Infos -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">

                <!-- Titre -->
                <TextBlock Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#212121"
                           TextTrimming="CharacterEllipsis"
                           Height="42"
                           TextWrapping="Wrap"
                           MaxHeight="42"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Auteur -->
                    <TextBlock Text="{Binding Author}"
                               FontSize="14"
                               Foreground="#757575"
                               Margin="0,4,0,0"/>

                    <!-- ✅ CORRECTION: Empêcher le bouton menu de déclencher le click parent -->
                    <Global:IconButton Grid.Column="1" 
                                       x:Name="MenuButton"
                                       IconKind="DotsVertical"
                                       IconColor="Black"
                                       ButtonHeight="20"
                                       ButtonWidth="20"
                                       IconSize="15"
                                       HorizontalAlignment="Right"
                                       Focusable="False"/>
                </Grid>

                <!-- Catégorie -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayCategory}"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PublishYear}"
                               FontSize="12"
                               Foreground="#9E9E9E"/>
                </Grid>
            </StackPanel>

            <!-- ✅ Popup contextuel avec commandes corrigées -->
            <Popup x:Name="ActionMenu"
                   Placement="MousePoint"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="White"
                        CornerRadius="8"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="6">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- ✅ CORRECTION: Ajouter CommandParameter -->
                        <Button Content="📖 Voir les détails"
                                Padding="10,5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowDetailBtnClick, ElementName=root}"
                                CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Separator Margin="0,2"/>

                        <!-- ✅ CORRECTION: Ajouter CommandParameter -->
                        <Button Content="📚 Emprunter"
                                Padding="10,5"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Command="{Binding BorrowBtnClick, ElementName=root}"
                                CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Button>
</UserControl>