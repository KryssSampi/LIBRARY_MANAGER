<UserControl x:Class="LIBBRARY_MANAGER.Views.BookViews.BookDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             Width="400"
             x:Name="root"
             Background="White">

    <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                   Background="#1565C0"
                   Padding="20">
                <Grid>
                    <TextBlock Text="Détails du Livre" 
                              FontSize="20"
                              FontWeight="SemiBold"
                              Foreground="White"
                              VerticalAlignment="Center"/>

                    <items:IconButton 
                        x:Name="CloseBtn"
                        IconKind="Close"
                                     IconSize="20"
                                     IconColor="White"
                                     ButtonColor="Transparent"
                                     ButtonWidth="36"
                                     ButtonHeight="36"
                                     Shape="Circle"
                          
                                     HorizontalAlignment="Right"
                              />
                </Grid>
            </Border>

            <!-- Contenu scrollable -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="20">
                <StackPanel>
                    <!-- Couverture -->
                    <Border CornerRadius="8"
                           Background="#F5F5F5"
                           Height="400"
                           Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="15" ShadowDepth="5"/>
                        </Border.Effect>
                        <Image Source="{Binding DisplayCoverUrl}" 
                              Stretch="Uniform"/>
                    </Border>

                    <!-- Titre -->
                    <TextBlock Text="{Binding Title}" 
                              FontSize="24"
                              FontWeight="Bold"
                              Foreground="#212121"
                              TextWrapping="Wrap"
                              Margin="0,0,0,10"/>

                    <!-- Auteur -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="par " 
                                  FontSize="16"
                                  Foreground="#757575"/>
                        <TextBlock Text="{Binding Author}" 
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#1565C0"/>
                    </StackPanel>

                    <!-- Informations détaillées -->
                    <StackPanel>
                        <!-- ISBN -->
                        <Border Background="#F5F5F5" 
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="ISBN" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#757575"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding ISBN}" 
                                          FontSize="14"
                                          Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Catégorie -->
                        <Border Background="#F5F5F5" 
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="Catégorie" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#757575"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding DisplayCategory}" 
                                          FontSize="14"
                                          Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Date de publication -->
                        <Border Background="#F5F5F5" 
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="Publication" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#757575"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding PublishDateFormatted}" 
                                          FontSize="14"
                                          Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Disponibilité -->
                        <Border Background="#F5F5F5" 
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="Disponibilité" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#757575"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="10" 
                                            Height="10"
                                            Fill="{Binding AvailabilityColor}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding AvailabilityText}" 
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{Binding AvailabilityColor}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="Description" 
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#212121"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Description}" 
                                  FontSize="14"
                                  Foreground="#757575"
                                  TextWrapping="Wrap"
                                  LineHeight="22"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer avec actions -->
            <Border Grid.Row="2" 
                   Background="#F5F5F5"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,1,0,0"
                   Padding="20">
                <StackPanel>
                    <Button Content="Emprunter ce livre"
                           Background="#1565C0"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Height="45"
                           BorderThickness="0"
                           Cursor="Hand"
                           Command="{Binding BorrowBtnClick , ElementName=root}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="8"
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Fermer"
                           Background="Transparent"
                           Foreground="#1565C0"
                           FontSize="14"
                           Height="40"
                           BorderBrush="#1565C0"
                           BorderThickness="2"
                           Cursor="Hand"
                           Margin="0,10,0,0"
                            Command="{Binding CloseCommand, ElementName=root}"
                            >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="8"
                                                   Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>