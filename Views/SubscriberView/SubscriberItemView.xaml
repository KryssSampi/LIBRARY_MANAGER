<UserControl x:Class="LIBBRARY_MANAGER.Views.SubscriberView.SubscriberItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             mc:Ignorable="d" 
             Height="80"
             x:Name="root"
             Cursor="Hand">

    <!-- ✅ CORRECTION: Ajouter CommandParameter pour passer le bon DataContext -->
    <Button x:Name="SubscriberItemButton"
            Command="{Binding ShowDetailCommand, ElementName=root}"
            CommandParameter="{Binding}"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand"
            ToolTip="Voir les détails">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ItemBorder"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6"
                        Padding="80,5,20,5"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Référence -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Ref_Subscriber}"
                                   FontSize="14"
                                   Foreground="#1565C0"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Padding="10,0"
                                   Margin="10"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Nom complet -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FullName}" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#212121"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Email -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Email}"
                                   FontSize="13"
                                   Foreground="#616161"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Fidélité -->
                        <StackPanel Grid.Column="3" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" 
                                     Fill="{Binding FidelityColor}" 
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Fidelity, StringFormat='{}{0:F2}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Foreground="{Binding FidelityColor}"/>
                        </StackPanel>

                        <!-- Emprunts actifs -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding ActiveLoansCount}"
                                   FontSize="14"
                                   Foreground="#555"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>

                        <!-- Peut emprunter -->
                        <Border Grid.Column="5"
                                Background="{Binding CanBorrow, Converter={StaticResource BoolToColorConverter}}"
                                CornerRadius="3"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0">
                            <TextBlock Text="{Binding CanBorrow, Converter={StaticResource BoolToTextConverter}}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Date d'inscription -->
                        <TextBlock Grid.Column="6"
                                   Text="{Binding Date_Creation, StringFormat='{}{0:dd MMM yyyy}'}"
                                   FontSize="13"
                                   Foreground="#9E9E9E"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>

                        <!-- Icône -->
                        <items:IconButton Grid.Column="8"
                                          VerticalAlignment="Center"
                                          IconKind="Eye"
                                          IconSize="18"
                                          HorizontalAlignment="Center"
                                          IconColor="#757575"
                                          ButtonColor="Transparent"
                                          ButtonWidth="32"
                                          ButtonHeight="32"
                                       Command="{Binding ShowDetailCommand, ElementName=root}"
                                          Shape="Circle"
                                          ToolTip="Voir les détails"
                                          Focusable="False"/>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <!-- Survol -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.03" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.03" Duration="0:0:0.15"/>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#1976D2" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FAFAFA" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.15"/>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#E0E0E0" Duration="0:0:0.25"/>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="White" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>

                    <!-- Clic (pressé) -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ItemBorder" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>