<UserControl x:Class="LIBBRARY_MANAGER.Views.SubscriberView.SUBSDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items" xmlns:model="clr-namespace:LIBBRARY_MANAGER.Model" xmlns:subscribersviewmodel="clr-namespace:LIBBRARY_MANAGER.ViewModel.SubscribersViewModel" d:DataContext="{d:DesignInstance Type=subscribersviewmodel:SubscriberItemViewModel}"
             mc:Ignorable="d" 
             x:Name="root"
             Background="White">

    <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#1565C0"
                    Padding="20">
                <Grid>
                    <TextBlock Text="Détails de l'Abonné"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <items:IconButton x:Name="CloseBtn"
                                      IconKind="Close"
                                      IconSize="20"
                                      IconColor="White"
                                      ButtonColor="Transparent"
                                      ButtonWidth="36"
                                      ButtonHeight="36"
                                      Shape="Circle"
                                      HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Contenu -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20" 
                          Style="{StaticResource ModernScrollViewer}">
                <StackPanel>

                    <!-- Avatar -->
                    <Border CornerRadius="100"
                            Width="150"
                            Height="150"
                            Background="#E3F2FD"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                        <Viewbox>
                            <items:IconButton IconKind="Account" IsEnabled="False"/>
                        </Viewbox>
                    </Border>

                    <!-- Nom complet -->
                    <TextBlock Text="{Binding Name_User}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#212121"
                               TextAlignment="Center"
                               Margin="0,0,0,5"/>

                    <!-- Référence -->
                    <TextBlock Text="{Binding Ref_Subscriber}"
                             Background="Transparent"
                             
                               FontSize="18"
                               Foreground="#757575"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Bloc d'informations -->
                    <StackPanel>
                        <!-- Adresse mail -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Courriel"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding Adresse_Mail}"
                                           Grid.Column="1"
                                           Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Téléphone -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Téléphone"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding Num_Telephone}"
                                           Grid.Column="1"
                                           Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Adresse -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Adresse"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding Adresse}"
                                           Grid.Column="1"
                                           Foreground="#212121"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Date de naissance -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Date de naissance"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding SubscriberInstance.BirthDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                           Grid.Column="1"
                                           Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Âge -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Âge"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding SubscriberInstance.Age}"
                                           Grid.Column="1"
                                           Foreground="#212121"/>
                            </Grid>
                        </Border>

                        <!-- Fidélité -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fidélité"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Fidelity}"
                                                 Maximum="10"
                                                 Width="150"
                                                 Height="10"
                                                 Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Fidelity, StringFormat='{}{0:F1}/10'}"
                                               VerticalAlignment="Center"
                                               Foreground="#1565C0"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Statut d'emprunt -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Emprunts actifs"
                                           Grid.Column="0"
                                           FontWeight="SemiBold"
                                           Foreground="#757575"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{Binding ActiveLoansColor}"
                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ActiveLoansCount}"
                                               FontWeight="SemiBold"
                                               Foreground="#212121"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Padding="20">
                <StackPanel>
                    <Button Content="Voir les emprunts"
                            Background="#637BA3"
                            IsEnabled="False"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Height="45"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ViewLoansCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ✅ CORRECTION: Connecter CloseCommand au bouton Fermer -->
                    <Button x:Name="CloseLabel"
                            Content="Fermer"
                            Background="Transparent"
                            Foreground="#1565C0"
                            FontSize="14"
                            Height="40"
                            BorderBrush="#1565C0"
                            BorderThickness="2"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            Command="{Binding CloseCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>