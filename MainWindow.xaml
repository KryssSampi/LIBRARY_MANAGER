<Window x:Class="LIBBRARY_MANAGER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LIBBRARY_MANAGER" xmlns:NavaBar="clr-namespace:LIBBRARY_MANAGER.UI.Modules.Navbar" xmlns:GlobalItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
        mc:Ignorable="d"
        Width="1125"
        Height="600"
        WindowStyle="None"
        x:Name="root"
        Title="MainWindow" >
    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">


        <ContentControl VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch" Margin="80,0,0,0" x:Name="MainContent"  MaxHeight="{Binding ActualHeight, ElementName=root}" />
        <NavaBar:ResponsiveNavBar x:Name="MainNavbar" HorizontalAlignment="Left"  MinWidth="80" />
        <StackPanel  Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" >
            <GlobalItems:IconButton x:Name="ReduceBtn"  IconKind="Minus"  VerticalAlignment="Top" HorizontalAlignment="Right" IconColor="DimGray" IconSize="15" Margin="20,0" />
            <GlobalItems:IconButton x:Name="ResizeBtn"  IconKind="ArrowTopRightBottomLeft"  VerticalAlignment="Top" HorizontalAlignment="Right" IconColor="DimGray" IconSize="15" Margin="10,0" />
            <GlobalItems:IconButton x:Name="CloseBtn"  IconKind="Close"  VerticalAlignment="Top" HorizontalAlignment="Right" IconColor="Red" IconSize="15" Margin="10,0" />
        </StackPanel>
    </Grid>
</Window>
