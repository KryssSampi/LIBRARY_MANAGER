<UserControl x:Class="LIBBRARY_MANAGER.LoginModule.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.LoginModule.Views" xmlns:vm="clr-namespace:LIBBRARY_MANAGER.LoginModule.ViewModel"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Rounded Buttons-->
        <Style TargetType="Button" x:Key="LogBoutton">
            <Setter Property="Background" Value="#0370C3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- 🟦 Effet Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Variation douce du bleu -->
                                            <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#0598F0" Duration="0:0:0.25" />
                                            <!-- Agrandissement fluide -->
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.08" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.08" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Retour à la couleur et taille d'origine -->
                                            <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#0370C3" Duration="0:0:0.25" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 🔵 Effet Click -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#025B9E" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.96" Duration="0:0:0.05" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.96" Duration="0:0:0.05" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#0370C3" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Rounded TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <!-- Rounded corners -->
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!--#region Left of the Grid-->
        <Grid Grid.Column="0">
            <MediaElement x:Name="MainFrame" Source="/LoginModule/Ressources/Videos/media.mp4"
              Stretch="Uniform"
          LoadedBehavior="Play"
    UnloadedBehavior="Manual"
    MediaEnded="BackgroundVideo_MediaEnded"
    IsMuted="True"
                          SpeedRatio="0.3"
              />
        </Grid>
        <!--#endregion-->

        <!--#region Right of the Grid-->
        <Grid Grid.Column="1" Width="356">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="1" Name="Titre" Source="/LoginModule/Ressources/Images/85e289383c89c603475d254818c426811c27c768.png" Width="160" Height="40" Margin="30,5,0,0" HorizontalAlignment="Center" Stretch="Fill"/>

            <Image Name="Logo" Source="/LoginModule/Ressources/Images/wise-owl-reading-book-vintage-style-learning-icon-vector-57215705.png" Width="80" Margin="10,5,0,0" HorizontalAlignment="Center" Stretch="Fill" />

            <StackPanel Margin="0,5,0,10" Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="Nom d'utilisateur" FontFamily="Segoe UI" FontSize="15" Foreground="#255F7E"/>
                <TextBox Text="{Binding Username}" Width="250" Margin="0,5,0,10" Padding="5"/>

                <TextBlock Text="Mot de passe"  FontFamily="Segoe UI" FontSize="15" Foreground="#255F7E"/>

                <!-- Password Grid -->
                <Grid Margin="0,5,0,10" >
                    <!-- Hidden Password -->
                    <PasswordBox Name="PasswordBox" Padding="5" PasswordChanged="PasswordBox_PasswordChanged" Visibility="Visible" />

                    <!-- Visible Password -->
                    <TextBox Name="PasswordTextBox" Padding="5" TextChanged="PasswordTextBox_TextChanged" Visibility="Collapsed" />

                    <!-- Show/Hide Button -->
                    <Button Name="TogglePasswordButton" Grid.Row="1" Width="20" Height="20"  Background="Transparent" Margin="0,0,5,0"  BorderThickness="0" HorizontalAlignment="Right" Click="TogglePasswordButton_Click">
                        <Image Name="EyeIcon" Source="/LoginModule/Ressources/Images/Icons/eye-svgrepo-com.png" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Bouton pour s'inscrire-->
                <TextBlock Style="{StaticResource LinkTextBlock}"  Text="S'inscrire" Width="75" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"  Background="White" Foreground="#0370C3" TextAlignment="Center" />

                <!-- Bouton pour oubli de mot de passe -->
                <TextBlock Style="{StaticResource LinkTextBlock}" Text="Mot de passe oublié" Width="125" Height="30" Margin="25,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"   Background="White" Foreground="#0370C3" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Margin="55,35,55,10" TextAlignment="Left" Foreground="{Binding MessageColor}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Grid.Row="3" TextWrapping="Wrap"  Visibility="{Binding ErrorMessage , Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button  Style="{StaticResource LogBoutton}" Content="Se connecter" Width="280" Height="40" Command="{Binding LoginCommand}" Grid.Row="4" />

            <Image Name="Livres1" Source="/LoginModule/Ressources/Images/Gemini_Generated_Image_ogly0togly0togly.png" Width="220" Height="60" Margin="15,20,0,0" Stretch="Fill" HorizontalAlignment="Left" Grid.Row="5"/>

            <Image Name="Livres2" Source="/LoginModule/Ressources/Images/pngtree-blue-book-image_1325902.jpg" Width="80" Height="70" Margin="0,15,10,0" Stretch="Fill" HorizontalAlignment="Right" Grid.Row="5"/>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>
