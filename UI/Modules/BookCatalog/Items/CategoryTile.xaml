<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.BookCatalog.Items.CategoryTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             Cursor="Hand">

    <Border x:Name="TileBorder"
           Background="{Binding TileBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
           BorderBrush="{Binding BorderColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
           BorderThickness="4"
           CornerRadius="12"
           Margin="10"
           Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#1565C0" 
                            Opacity="0.15" 
                            BlurRadius="10" 
                            ShadowDepth="2"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icône -->
            <Viewbox Grid.Column="0" Width="80" Height="80" Margin="20,0">
                <items:IconButton IconKind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 IconSize="30"
                                 IconColor="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 ButtonColor="Transparent"
                                 IsEnabled="False"/>
            </Viewbox>

            <!-- Textes -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Titre -->
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          FontSize="30" 
                          FontWeight="SemiBold"
                          Foreground="#212121"
                          TextAlignment="Left"
                          Margin="0,0,0,5"/>

                <!-- Compteur -->
                <TextBlock Text="{Binding BookCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          FontSize="18"
                          Foreground="#757575"
                          TextAlignment="Left"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>