<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.HomeSpace.Items.OperationView.OperationItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             x:Name="root"
             Height="70"
             Cursor="Hand">

    <Button Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand">

        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ItemBorder"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6"
                        Padding="12,8">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FAFAFA" Offset="0.0"/>
                            <GradientStop Color="#F4F7FA" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icône de type -->
                        <Border Grid.Column="0"
                                Width="45"
                                Height="45"
                                CornerRadius="22.5"
                                Background="{Binding IconBackground}"
                                Margin="0,0,12,0">
                            <items:IconButton IconKind="{Binding IconKind}"
                                              IconColor="{Binding IconColor}"
                                              IconSize="22"
                                              ButtonColor="Transparent"
                                              IsEnabled="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <!-- Type d'opération + Référence -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OperationTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TitleColor}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Reference}"
                                       FontSize="11"
                                       Foreground="#888"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Livre -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="📚 Livre"
                                       FontSize="10"
                                       Foreground="#999"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding BookTitle}"
                                       FontSize="13"
                                       Foreground="#333"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BookTitle}"/>
                        </StackPanel>

                        <!-- Abonné -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="👤 Abonné"
                                       FontSize="10"
                                       Foreground="#999"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SubscriberName}"
                                       FontSize="13"
                                       Foreground="#333"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SubscriberName}"/>
                        </StackPanel>

                        <!-- Date + Heure -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OperationDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                       FontSize="12"
                                       Foreground="#555"
                                       FontWeight="Medium"/>
                            <TextBlock Text="{Binding OperationDate, StringFormat='{}{0:HH:mm}'}"
                                       FontSize="11"
                                       Foreground="#888"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Statut -->
                        <Border Grid.Column="5"
                                Background="{Binding StatusBackground}"
                                CornerRadius="12"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusForeground}"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Animations -->
                <ControlTemplate.Triggers>
                    <!-- Survol -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                                    To="#E6EEF9"
                                                    Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.02"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.02"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>

                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                                    To="#F4F7FA"
                                                    Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1"
                                                     Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1"
                                                     Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>

                    <!-- Appui -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8F0FE" Offset="0.0"/>
                                    <GradientStop Color="#D2E3FC" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>