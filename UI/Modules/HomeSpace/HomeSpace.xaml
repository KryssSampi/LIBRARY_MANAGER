<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.HomeSpace.HomeSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace"
             xmlns:MainItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items.MainView"
             xmlns:GlobalItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items" 
             xmlns:vm="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace.ViewModel"
             mc:Ignorable="d" 
             x:Name="root"
             d:Background="White"
             d:DesignHeight="584" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="StyleDeBase" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B8E7F"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        SnapsToDevicePixels="True"
                        RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.3*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icône -->
                                <GlobalItems:IconButton IconKind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                IconColor="{TemplateBinding BorderBrush}"
                                                VerticalAlignment="Center"
                                                Width="80" Height="80"
                                                        IconSize="40"
                                                   
                                                IsEnabled="False"
                                               />

                                <!-- Texte -->
                                <TextBlock Grid.Column="1"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Uid}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Style="{StaticResource LinkTextBlock}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- 🎬 Triggers animés -->
                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.07" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.07" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Leave -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Press -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="0.95" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="0.95" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Release -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.07" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.07" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>
    <Grid>
        
        <!-- Définition des lignes -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.65*"/>
            <RowDefinition Height="0.35*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <MainItems:Header  
      Grid.Row="0"
      Background="White"
      HorizontalContentAlignment="Center"
      LogoPath="/UI/Common/Assets/BookCatalog_Images/Noctua_Blue.png"
      SideImagePath="/UI/Common/Assets/BookCatalog_Images/Noctua_On_Book.png"
      Title="Gestionnaire de Bibliothèque"
      Subtitle="''La connaissance s'acquiert par l'expérience, tout le reste n'est que de l'information.''"
            Grid.ColumnSpan="4"
            
            />
        <TextBlock Grid.Row="0" 
           Text="-- ALBERT EINSTEIN"
           TextAlignment="Center"
           VerticalAlignment="Bottom"
           HorizontalAlignment="Right"
           FontSize="15"
           FontWeight="Bold"
                   Margin="20,0"
           FontFamily="NanumMyeongjo"
           Foreground="#002847"/>
        <Grid Grid.Row="2">
            <UniformGrid Rows="1" Columns="2">
                <!-- Images -->
                <Border  BorderBrush="#0370C3" BorderThickness="1,1,0,1">
                    <Image x:Name="Image1" Source="/UI/Modules/HomeSpace/Assets/image1.png" Stretch="Fill"
     HorizontalAlignment="Stretch"
     VerticalAlignment="Stretch"/>
                </Border>

                <Border   BorderBrush="#0370C3" BorderThickness="0,1,1,1">
                    <Image x:Name="Image2" Source="/UI/Modules/HomeSpace/Assets/image2.png"  Stretch="Fill"
            />
                </Border>

            </UniformGrid>
            <StackPanel>
                <TextBlock Text="{Binding currentuser.Name_User , StringFormat='Bienvenue {0} !'}" FontSize="40" Foreground="{StaticResource DarkBlue}"   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <UniformGrid  Columns="3" Rows="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Boutons -->

                    <!-- Bouton Emprunt de Livre(s) -->
                <Button BorderBrush="#2C5F7C" 
                Style="{StaticResource StyleDeBase}" 
                Command="{Binding BorrowCommand}"  Tag="BookArrowRight" Foreground="{StaticResource PrimaryBlue}" Uid="Emprunter un Livre " />

                <!-- Gestion des livres -->
                <Button BorderBrush="#4A4A4A" Style="{StaticResource StyleDeBase}" Command="{Binding OpenCatalogueCommand}" Tag="Bookshelf" Foreground="{StaticResource PrimaryBlue}" Uid="Catalogue des livres"  />

                <!-- Bouton Gestion des abonnés -->
                    <Button BorderBrush="#6B5B8E" Style="{StaticResource StyleDeBase}" Command="{Binding OpenSubscribersCommand}" Tag="AccountGroup" Uid="Gestion Des Abonnées" Foreground="{StaticResource PrimaryBlue}"/>
                    <!-- Bouton Retour de Livre(s) -->
                    <Button BorderBrush="#6B8E7F"     Style="{StaticResource StyleDeBase}"    Command="{Binding ReturnCommand}" Tag="BookArrowLeftOutline" Uid="Effectuer Un Retour" />

                    <!--  Bouton Gestion des emprunts -->
                    <Button BorderBrush="#8B4049" Style="{StaticResource StyleDeBase}" Command="{Binding OpenLoansCommand}" Tag="BookCog" Uid="Gestionnaire des Emprunts"/>

                    <!-- Bouton Calendrier -->
                    <Button BorderBrush="#C9A961" Style="{StaticResource StyleDeBase}" Tag="Calendar" Uid="Calendrier des Evenments"/>
                </UniformGrid></StackPanel>
        </Grid>
  
    

        <!-- Affichage des opérations -->
        <UniformGrid Grid.Row="3" Columns="1" x:Name="OperationsGrid"  Visibility="{Binding Operations,ElementName= root , Converter={StaticResource NullTovisiblityReverseConverter}}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Ici s'affiche vos opérations du jour :"
            FontWeight="Bold"
            FontStyle="Italic"
            FontSize="20"
            Foreground="#80000000"
            FontFamily="Arimo Hebrew Subset Italic"
            TextAlignment="Center"/>
                <TextBlock Text="(Vous n'avez pas fait d'opération aujourd'hui)"
            FontWeight="Bold"
            FontStyle="Italic"
            FontSize="20"
            Foreground="#4D000000"
            FontFamily="Arimo Hebrew Subset Italic"
            TextAlignment="Center"/>
            </StackPanel>
        </UniformGrid>
    </Grid>
</UserControl>
