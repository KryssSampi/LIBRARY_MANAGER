<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.HomeSpace.HomeSpace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace"
             xmlns:MainItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items.MainView"
             xmlns:GlobalItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items" 
             xmlns:vm="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace.ViewModel" xmlns:views="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace.Items.BasicListItems.Views" xmlns:localItems="clr-namespace:LIBBRARY_MANAGER.UI.Modules.HomeSpace.Items.OperationView"
             mc:Ignorable="d" 
             x:Name="root"
             d:Background="White"
             d:DesignHeight="584" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="StyleDeBase" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B8E7F"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        SnapsToDevicePixels="True"
                        RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.3*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icône -->
                                <GlobalItems:IconButton IconKind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                IconColor="{TemplateBinding BorderBrush}"
                                                VerticalAlignment="Center"
                                                Width="80" Height="80"
                                                        IconSize="40"
                                                   
                                                IsEnabled="False"
                                               />

                                <!-- Texte -->
                                <TextBlock Grid.Column="1"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Uid}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Style="{StaticResource LinkTextBlock}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- 🎬 Triggers animés -->
                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.07" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.07" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Leave -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Press -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="0.95" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="0.95" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Release -->
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.07" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.07" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>
    <Grid>
        
        <!-- Définition des lignes -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <MainItems:Header  
      Grid.Row="0"
      Background="White"
      HorizontalContentAlignment="Center"
      LogoPath="/UI/Common/Assets/BookCatalog_Images/Noctua_Blue.png"
      SideImagePath="/UI/Common/Assets/BookCatalog_Images/Noctua_On_Book.png"
      Title="Gestionnaire de Bibliothèque"
      Subtitle="''La connaissance s'acquiert par l'expérience, tout le reste n'est que de l'information.''"
            Grid.ColumnSpan="4"
            
            />
        <TextBlock Grid.Row="0" 
           Text="-- ALBERT EINSTEIN"
           TextAlignment="Center"
           VerticalAlignment="Bottom"
           HorizontalAlignment="Right"
           FontSize="15"
           FontWeight="Bold"
                   Margin="20,0"
           FontFamily="NanumMyeongjo"
           Foreground="#002847"/>
        <Grid Grid.Row="2">
            <UniformGrid Rows="1" Columns="2">
                <!-- Images -->
                <Border  BorderBrush="#0370C3" BorderThickness="1,1,0,1">
                    <Image x:Name="Image1" Source="/UI/Modules/HomeSpace/Assets/image1.png" Stretch="Fill"
     HorizontalAlignment="Stretch"
     VerticalAlignment="Stretch"/>
                </Border>

                <Border   BorderBrush="#0370C3" BorderThickness="0,1,1,1">
                    <Image x:Name="Image2" Source="/UI/Modules/HomeSpace/Assets/image2.png"  Stretch="Fill"
            />
                </Border>

            </UniformGrid>
            <StackPanel>
                <TextBlock Text="{Binding currentuser.Name_User , StringFormat='Bienvenue {0} !'}" FontSize="40" Foreground="{StaticResource DarkBlue}"   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <UniformGrid  Columns="3" Rows="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Boutons -->

                    <!-- Bouton Emprunt de Livre(s) -->
                <Button BorderBrush="#2C5F7C" 
                Style="{StaticResource StyleDeBase}" 
                Command="{Binding BorrowCommand}"  Tag="BookArrowRight" Foreground="{StaticResource PrimaryBlue}" Uid="Emprunter un Livre " />

                <!-- Gestion des livres -->
                <Button BorderBrush="#4A4A4A" Style="{StaticResource StyleDeBase}" Command="{Binding OpenCatalogueCommand}" Tag="Bookshelf" Foreground="{StaticResource PrimaryBlue}" Uid="Catalogue des livres"  />

                <!-- Bouton Gestion des abonnés -->
                    <Button BorderBrush="#6B5B8E" Style="{StaticResource StyleDeBase}" Command="{Binding OpenSubscribersCommand}" Tag="AccountGroup" Uid="Gestion Des Abonnées" Foreground="{StaticResource PrimaryBlue}"/>
                    <!-- Bouton Retour de Livre(s) -->
                    <Button BorderBrush="#6B8E7F"     Style="{StaticResource StyleDeBase}"    Command="{Binding ReturnCommand}" Tag="BookArrowLeftOutline" Uid="Effectuer Un Retour" />

                    <!--  Bouton Gestion des emprunts -->
                    <Button BorderBrush="#8B4049" Style="{StaticResource StyleDeBase}" Command="{Binding OpenLoansCommand}" Tag="BookCog" Uid="Gestionnaire des Emprunts"/>

                    <!-- Bouton Calendrier -->
                    <Button BorderBrush="#C9A961" Style="{StaticResource StyleDeBase}" Tag="Calendar" Uid="Calendrier des Evenments"/>
                </UniformGrid></StackPanel>
        </Grid>
  
    

        <!-- Affichage des opérations -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête avec statistiques -->
            <Border Grid.Row="0" 
            Background="#F5F8FA"
            BorderBrush="#E1E8ED"
            BorderThickness="0,1,0,1"
            Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="📊" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mes opérations du jour" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DarkBlue}"
                           VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Compteurs -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Badge Emprunts -->
                        <Border Background="#2ECC71"
                        CornerRadius="12"
                        Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📗"
                                   FontSize="14"
                                   Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OperationsVM.LoansCount, FallbackValue=0}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,4,0"/>
                                <TextBlock Text="emprunt(s)"
                                   FontSize="12"
                                   Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Modifications -->
                        <Border Background="#3498DB"
                        CornerRadius="12"
                        Padding="12,4"
                        Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄"
                                   FontSize="14"
                                   Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding OperationsVM.ModificationsCount, FallbackValue=0}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,4,0"/>
                                <TextBlock Text="modification(s)"
                                   FontSize="12"
                                   Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TabControl avec 2 onglets -->
            <TabControl Grid.Row="1"
                Background="White"
                BorderThickness="0">

                <TabControl.Resources>
                    <!-- Style des onglets -->
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,3"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F0F4F8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ============================================
             ONGLET 1 : EMPRUNTS DU JOUR
             ============================================ -->
                <TabItem Header="📗 Emprunts du jour">
                    <Grid>
                        <!-- Liste des emprunts -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10"
                                      Style="{StaticResource ModernScrollViewer}"
                              Visibility="{Binding OperationsVM.LoansCount, 
                                           Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding OperationsVM.TodayLoans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <localItems:OperationItemView Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Message si vide -->
                        <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding OperationsVM.LoansCount, 
                                         Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <TextBlock Text="📋"
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Opacity="0.3"
                               Margin="0,0,0,20"/>
                            <TextBlock Text="Aucun emprunt aujourd'hui"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#999"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                            <TextBlock Text="Les emprunts créés aujourd'hui apparaîtront ici"
                               FontSize="14"
                               FontStyle="Italic"
                               Foreground="#BBB"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============================================
             ONGLET 2 : MODIFICATIONS DU JOUR
             ============================================ -->
                <TabItem Header="🔄 Mes modifications">
                    <Grid>
                        <!-- Liste des modifications -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10"
                                      Style="{StaticResource ModernScrollViewer}"
                              Visibility="{Binding OperationsVM.ModificationsCount, 
                                           Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding OperationsVM.TodayModifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <localItems:OperationItemView Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Message si vide -->
                        <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding OperationsVM.ModificationsCount, 
                                         Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <TextBlock Text="🔧"
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Opacity="0.3"
                               Margin="0,0,0,20"/>
                            <TextBlock Text="Aucune modification aujourd'hui"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#999"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                            <TextBlock Text="Vos retours et prolongations apparaîtront ici"
                               FontSize="14"
                               FontStyle="Italic"
                               Foreground="#BBB"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
