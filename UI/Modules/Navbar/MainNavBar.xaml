<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.Navbar.ResponsiveNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Globalitems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Modules.Navbar"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="80"
             x:Name="root"
             SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style de base pour les boutons de navigation -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="15"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border x:Name="IconContainer"
                                        Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="20"
                                        Background="Transparent"
                                        BorderThickness="2"
                                        BorderBrush="#F1F1F1">
                                    <ContentPresenter x:Name="IconPresenter"
                                                     Content="{TemplateBinding Tag}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <Globalitems:IconButton 
                                                    IconKind="{Binding IconKind}" 
                                                    IconColor="White"
                                                    ButtonColor="Transparent"
                                                    IconSize="24"
                                                    ButtonWidth="36"
                                                    ButtonHeight="36"
                                                    BorderThickness="0"
                                                    IsEnabled="False"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>

                                <!-- Text Label -->
                                <TextBlock x:Name="NavText"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="15,0,10,0"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          Foreground="White"
                                           ToolTip="{Binding Text}"
                                          Opacity="0"
                                          Visibility="Collapsed">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TextTransform" X="-15"/>
                                    </TextBlock.RenderTransform>
                                    <ContentPresenter Content="{TemplateBinding Tag}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.05" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.05" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#2055A5" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="Transparent" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Pressed Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.95" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.95" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ACTIF pour le bouton sélectionné -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#2055A5" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F1F1F1"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container - Style Actif -->
                                <Border x:Name="IconContainer"
                                        Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="20"
                                        Background="Transparent"
                                        BorderThickness="2"
                                        BorderBrush="{StaticResource PrimaryBlue}">
                                    <ContentPresenter x:Name="IconPresenter"
                                                     Content="{TemplateBinding Tag}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <Globalitems:IconButton 
                                                    IconKind="{Binding IconKind}" 
                                                    IconColor="{StaticResource DarkBlue}"
                                                    ButtonColor="Transparent"
                                                    IconSize="24"
                                                    ButtonWidth="36"
                                                    ButtonHeight="36"
                                                    BorderThickness="0"
                                                    IsEnabled="False"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>

                                <!-- Text Label -->
                                <TextBlock x:Name="NavText"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="15,0,10,0"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          Foreground="{StaticResource DarkBlue}"
                                          Opacity="0"
                                          Visibility="Collapsed">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TextTransform" X="-15"/>
                                    </TextBlock.RenderTransform>
                                    <ContentPresenter Content="{TemplateBinding Tag}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les items du menu overflow -->
        <Style x:Key="OverflowMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuItemBorder" 
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                Content="{TemplateBinding Tag}">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <Globalitems:IconButton 
                                                IconKind="{Binding IconKind}" 
                                                IconColor="White"
                                                ButtonColor="Transparent"
                                                IconSize="20"
                                                ButtonWidth="32"
                                                ButtonHeight="32"
                                                BorderThickness="0"
                                                IsEnabled="False"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>

                                <ContentPresenter Grid.Column="1"
                                                Content="{TemplateBinding Tag}" 
                                                Margin="12,0,0,0">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" 
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     FontSize="14"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" 
                                      Value="{StaticResource DarkBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid"
          Background="{StaticResource PrimaryBlue}" 
          MouseEnter="NavBar_MouseEnter" 
          MouseLeave="NavBar_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Avatar Section -->
        <Border Grid.Row="0" 
                Margin="5,20,5,15"
                HorizontalAlignment="Center">
            <Globalitems:IconButton 
                x:Name="AvatarButton"
                IconKind="Account"
                Shape="Circle"
                BorderThickness="2"
                BorderBrush="White"
                ButtonWidth="45"
                ButtonHeight="45"
                IconSize="28"
                HorizontalAlignment="Center"
                IconColor="White"
                ButtonColor="Transparent"
                Cursor="Hand"
                MouseLeftButtonUp="AvatarButton_Click"/>
        </Border>

        <Separator Grid.Row="1" 
                   Height="2" 
                   Background="{StaticResource DarkBlue}" 
                   Margin="10,0"/>

        <!-- Navigation Items Container -->
        <ScrollViewer Grid.Row="2" 
                     Margin="0,10,0,10"
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Disabled"
                     Style="{StaticResource ModernScrollViewer}">
            <StackPanel x:Name="MainNavPanel">
                <!-- Dynamic Navigation Buttons -->
                <ItemsControl x:Name="VisibleButtonsContainer" 
                            ItemsSource="{Binding VisibleNavItems, ElementName=root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButtonStyle}"
                                  Tag="{Binding}"
                                  Click="NavButton_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Menu Button (visible si items cachés) -->
                <Button x:Name="MenuButton"
                      Style="{StaticResource NavButtonStyle}"
                      Click="MenuButton_Click"
                      Visibility="{Binding HasHiddenItems, ElementName=root, Converter={StaticResource BoolToVis}}">
                    <Button.Tag>
                        <local:NavItem Label="Menu" IconKind="Menu"/>
                    </Button.Tag>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Section -->
        <StackPanel Grid.Row="3" Margin="0,10,0,20">
            <Button x:Name="AccountButton"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="{Binding AccountManagerItem, ElementName=root}"
                  Click="NavButton_Click"/>
            <Separator Height="2" 
                  Background="{StaticResource DarkBlue}" 
                  Margin="10,0,10,10"/>
            <Button x:Name="LogoutButton"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="{Binding LogoutItem, ElementName=root}"
                  Click="NavButton_Click"/>
        </StackPanel>

        <!-- Overflow Menu Popup -->
        <Popup x:Name="OverflowMenuPopup"
               PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Right"
               StaysOpen="False"
               AllowsTransparency="True"
               HorizontalOffset="10"
               VerticalOffset="-5">
            <Border Background="{StaticResource PrimaryBlue}" 
                    BorderBrush="{StaticResource DarkBlue}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" 
                                    Opacity="0.3" 
                                    BlurRadius="15" 
                                    ShadowDepth="5"/>
                </Border.Effect>

                <ScrollViewer MaxHeight="400" 
                            VerticalScrollBarVisibility="Auto"
                            Style="{StaticResource ModernScrollViewer}">
                    <ItemsControl x:Name="HiddenButtonsContainer" 
                                ItemsSource="{Binding HiddenNavItems, ElementName=root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OverflowMenuItemStyle}"
                                      Tag="{Binding}"
                                      Click="OverflowMenuItem_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>