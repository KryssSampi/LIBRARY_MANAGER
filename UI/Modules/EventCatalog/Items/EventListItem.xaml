<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.EventCatalog.Items.EventListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80"
             Cursor="Arrow">

    <Border x:Name="ItemBorder"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"
            CornerRadius="6"
            Padding="10,15,25,10">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FAFAFA" Offset="0.0"/>
                <GradientStop Color="#F4F7FA" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <!-- Title -->
                <ColumnDefinition Width="1*" />
                <!-- Start -->
                <ColumnDefinition Width="1*" />
                <!-- End -->
                <ColumnDefinition Width="3*" />
                <!-- Description -->
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Column="0"
           Text="{Binding Title}"
           FontSize="16"
           FontWeight="SemiBold"
           Foreground="#1A1A1A"
           VerticalAlignment="Center"
           TextTrimming="CharacterEllipsis" />

            <!-- Start -->
            <TextBlock Grid.Column="1"
           Text="{Binding StartDate, StringFormat=' {0:yyyy-MM-dd}'}"
           FontSize="14"
           Foreground="#333"
           VerticalAlignment="Center" />

            <!-- End -->
            <TextBlock Grid.Column="2"
           Text="{Binding EndDate, StringFormat=' {0:yyyy-MM-dd}'}"
           FontSize="14"
           Foreground="#333"
           VerticalAlignment="Center" />

            <!-- Description -->
            <TextBlock Grid.Column="3"
           Text="{Binding Description}"
           FontSize="14"
           Foreground="#2A7FFF"
           VerticalAlignment="Center"
           TextTrimming="CharacterEllipsis"
           TextWrapping="Wrap"/>
        </Grid>
    </Border>

    <!-- Hover animations -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                    Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                    To="#E6EEF9"
                                    Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.05"
                                     Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.05"
                                     Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="ItemBorder"
                                    Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Color"
                                    To="#F4F7FA"
                                    Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1"
                                     Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="GridScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1"
                                     Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

</UserControl>