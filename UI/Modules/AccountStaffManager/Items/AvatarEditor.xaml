<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.AccountStaffManager.Items.AvatarEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:GlobalItem="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Modules.AccountStaffManager.Items"
             x:Name="root"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="220">

    <Grid>
        <!-- Avatar Container -->
        <Border x:Name="AvatarContainer" 
                CornerRadius="500" 
                Width="{Binding AvatarSize, ElementName=root}" 
                Height="{Binding AvatarSize, ElementName=root}"
                BorderThickness="3" 
                BorderBrush="{Binding BorderBrush, ElementName=root}">
            <Border.Effect>
                <DropShadowEffect Color="#204E7A" Opacity="0.3" 
                                BlurRadius="20" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <!-- Border pour l'image avatar -->
                <Border x:Name="AvatarImageBorder" 
                        CornerRadius="500"
                        ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush x:Name="AvatarImageBrush"
                                  ImageSource="{Binding AvatarSource, ElementName=root}" 
                                  Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Icône par défaut si pas d'image -->
                <Border x:Name="DefaultAvatarContainer"
                        CornerRadius="500"
                        Background="{Binding DefaultBackground, ElementName=root}">
                    <Border.Visibility>
                        <Binding Path="AvatarSource" ElementName="root">
                            <Binding.Converter>
                                <StaticResource ResourceKey="NullToVisibilityConverter" />
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>

                    <GlobalItem:IconButton 
                        Shape="Circle"
                        IconKind="Account"
                        IconSize="{Binding DefaultIconSize, ElementName=root}"
                        IconColor="White"
                        IsEnabled="False"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        BorderThickness="0"/>
                </Border>
            </Grid>
        </Border>

        <!-- Bouton Modifier Avatar -->
        <GlobalItem:IconButton 
            x:Name="ModifyAvatarBtn"
            IconKind="Pencil" 
            BorderThickness="2"  
            BorderBrush="{Binding BorderBrush, ElementName=root}" 
            Background="{Binding EditButtonBackground, ElementName=root}"
            ButtonHeight="{Binding EditButtonSize, ElementName=root}" 
            ButtonWidth="{Binding EditButtonSize, ElementName=root}" 
            Width="{Binding EditButtonContainer, ElementName=root}" 
            Height="{Binding EditButtonContainer, ElementName=root}" 
            Shape="Circle" 
            CornerRadius="500" 
            VerticalAlignment="Bottom" 
            HorizontalAlignment="Right" 
            IconSize="{Binding EditIconSize, ElementName=root}"
            Cursor="Hand">
            <GlobalItem:IconButton.Effect>
                <DropShadowEffect Color="#204E7A" Opacity="0.4" 
                                BlurRadius="15" ShadowDepth="3"/>
            </GlobalItem:IconButton.Effect>
        </GlobalItem:IconButton>

        <!-- Popup pour la sélection d'avatar -->
        <Popup x:Name="AvatarPopup"
               PlacementTarget="{Binding ElementName=ModifyAvatarBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="AvatarPopup_Closed">
            <items:ImageGridSelector 
                x:Name="ImageSelector"  
                Width="500"
                Height="300"
                Background="White"
                GridBackground="White" 
                HeaderBackground="{Binding HeaderBackground, ElementName=root}" 
                FooterBackground="{Binding FooterBackground, ElementName=root}"  
                ForegroundBrush="White"
                AccentBrush="{Binding AccentBrush, ElementName=root}"/>
        </Popup>
    </Grid>
</UserControl>