<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.AccountStaffManager.Items.ImageGridSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🟦 En-tête -->
        <Border Grid.Row="0"
                Background="{Binding HeaderBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Padding="12"
                BorderBrush="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0">
            <TextBlock Text="{Binding ImageCountText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0"
                       Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       />
        </Border>

        <!-- 🖼️ Grille d’images -->
        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource ModernScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10"
                      Background="{Binding GridBackground, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid x:Name="ImageGrid" />
        </ScrollViewer>

        <!-- 🟩 Boutons -->
        <Border Grid.Row="2"
                Background="{Binding FooterBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8"
                Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- ◄ Précédent -->
                <Button Content="◄ Précédent"
                        Width="140" Height="40" Margin="5"
                        Background="#FF8C00"
                        Tag="#FFB07A"
                        Uid="#E67E73"
                        Foreground="#F1F1F1"
                        FontWeight="Bold" FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource ActionBouton}"
                        Click="UndoButton_Click"/>

                <!-- ✓ Apply -->
                <Button Content="✓ Apply"
                        Width="140" Height="40" Margin="5"
                        Foreground="#F1F1F1"
                        Background="#4CAF50"
                        Tag="#5CB85C"
                        Uid="#3F7F4E"
                        Style="{StaticResource ActionBouton}"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
