<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.IconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             mc:Ignorable="d" 
             BorderThickness="{Binding SealedThickness , ElementName=root}"
             BorderBrush="{Binding SealedBrush, ElementName=root}"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">

    <Button x:Name="MainButton"
            Background="{Binding ButtonColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderBrush="{Binding BorderBrush,ElementName=root}"
            Padding="{Binding ButtonPadding, ElementName=root}"
            Width="{Binding ButtonWidth, ElementName=root}"
            Height="{Binding ButtonHeight, ElementName=root}"
            HorizontalAlignment="{Binding HorizontalAlignment, ElementName=root}"
            VerticalAlignment="{Binding VerticalAlignment, ElementName=root}"
            Cursor="Hand"
            Command="{Binding Command, ElementName=root}"
            CommandParameter="{Binding CommandParameter, ElementName=root}"
            Click="MainButton_Click">
        <Button.RenderTransform>
            <ScaleTransform x:Name="MainButtonScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
        </Button.RenderTransform>
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Border avec forme variable -->
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MainButtonScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ButtonShadow"
                                                          Color="{Binding ShadowColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Opacity="{Binding ShadowOpacity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          BlurRadius="{Binding ShadowBlur, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          ShadowDepth="{Binding ShadowDepth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Border.Effect>

                                    <!-- Contenu du bouton -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Container pour icône OU image -->
                                        <Grid Grid.Column="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

                                            <!-- Icône MahApps Material -->
                                            <iconPacks:PackIconMaterial x:Name="Icon"
                                                                        Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Foreground="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Visibility="{Binding UseImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <iconPacks:PackIconMaterial.RenderTransform>
                                                    <ScaleTransform x:Name="Iconscale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                                </iconPacks:PackIconMaterial.RenderTransform>
                                            </iconPacks:PackIconMaterial>

                                            <!-- Image personnalisée (depuis drawable) -->
                                            <Image x:Name="CustomImage"
                                                   Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="{Binding ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Height="{Binding ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding UseImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Image.RenderTransform>
                                                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>

                                        <!-- Texte (optionnel) -->
                                        <TextBlock x:Name="ButtonText"
                                                   Grid.Column="1"
                                                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="{Binding TextSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontWeight="{Binding TextWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{Binding TextColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   VerticalAlignment="Center"
                                                   Margin="{Binding TextMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Visibility="{Binding TextVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>

                                <!-- Overlay pour effet Ripple -->
                                <Border x:Name="RippleOverlay"
                                        Background="White"
                                        Opacity="0"
                                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Effet Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MainButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1.1"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="MainButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1.1"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="15"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MainButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="MainButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Effet Click -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Iconscale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.8"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="Iconscale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.8"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ImageScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.8"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ImageScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.8"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="RippleOverlay"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0.1"
                                                               Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Iconscale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="Iconscale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ImageScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ImageScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="RippleOverlay"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0"
                                                               Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- État Désactivé -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
    </Button>
</UserControl>