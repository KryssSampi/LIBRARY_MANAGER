<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.DateSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             mc:Ignorable="d" 
             d:Foreground="AliceBlue"
             x:Name="root"
             Width="Auto"
             d:DesignHeight="450" d:DesignWidth="800"
             BorderThickness="0"
            BorderBrush="{DynamicResource PrimaryBorderBrush}"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#FF444444"/>
    </UserControl.Resources>
    
        <Border CornerRadius="8"
            BorderBrush="{Binding BorderBrush, ElementName=root}"
            Background="{Binding Background, ElementName=root}"
            Padding="5,0"
                MaxWidth="{Binding ActualWidth , ElementName=root}"
            SnapsToDevicePixels="True">

        <StackPanel Orientation="Vertical" >

            <!-- 🔹 Ligne principale des sélecteurs -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                      > 

                <!-- Année -->
                    <Border CornerRadius="6"
                        BorderBrush="{Binding BorderBrush, ElementName=root}"
                        BorderThickness="1"
                        Padding="4,2"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Année :"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,6,0"
                                   Foreground="{Binding Foreground, ElementName=root}"/>
                            <TextBox MaxWidth="40" MaxHeight="25"
                                 BorderThickness="0"
                                 Background="Transparent"
                                     TextAlignment="Center"
                                  VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, ElementName=root}"
                                 Text="{Binding ElementName=root, Path=Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Mois -->
                    <Border CornerRadius="6"
                        BorderBrush="{Binding BorderBrush, ElementName=root}"
                        BorderThickness="1"
                        Padding="2,0"
                            Width="Auto"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mois :"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,6,0"
                                   Foreground="{Binding Foreground, ElementName=root}"/>
                            <TextBox  MaxWidth="30" MaxHeight="25" BorderThickness="0"
                             TextAlignment="Center"
                                VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{Binding Foreground, ElementName=root}"
                                 Text="{Binding ElementName=root, Path=Month, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Jour -->
                    <Border CornerRadius="6"
                        BorderBrush="{Binding BorderBrush, ElementName=root}"
                        BorderThickness="1"
                        Padding="4,2"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Jour :"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,6,0"
                                   Foreground="{Binding Foreground, ElementName=root}"/>
                        <TextBox MaxWidth="40" MaxHeight="25"
                                 BorderThickness="0"
                                             TextAlignment="Center"
     VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{Binding Foreground, ElementName=root}"
                                 Text="{Binding ElementName=root, Path=Day, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Calendrier -->
                <DatePicker  MaxWidth="30"
                            Margin="0,5,0,0"
                                SelectedDate="{Binding ElementName=root, Path=SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Foreground="{Binding Foreground, ElementName=root}"
                                BorderThickness="0"
                                Background="Transparent"/>
            </StackPanel>

                <!-- 🔸 Message d’erreur -->
                <TextBlock Text="{Binding ElementName=root, Path=ErrorMessage}"
                       Foreground="Red"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="6,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ElementName=root, Path=HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Border>
    </UserControl>
