<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.MainView.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Modules.BookCatalog.Items"
             mc:Ignorable="d"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             x:Name="root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Glass Morphism Effect -->
    <Border Background="{Binding PanelBackground, ElementName=root}"
           BorderBrush="#E0E0E0"
           BorderThickness="0,0,0,1"
           Padding="20,15">
        <Border.Effect>
            <BlurEffect Radius="0"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bouton retour -->
            <items:IconButton x:Name="BackButton"
                  Grid.Column="0"
                  IconKind="ArrowLeft"
                  IconSize="20"
                  IconColor="{Binding ItemsForeground, ElementName=root}"
                  ButtonColor="Transparent"
                  ButtonWidth="40"
                  ButtonHeight="40"
                  Shape="Circle"
                  ToolTip="Retour aux catégories"
                  Command="{Binding BackCommand, ElementName=root}"
                  Visibility="{Binding IsBackButtonVisible, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="0,0,10,0"/>


            <!-- Barre de recherche Glass Morphism -->
            <Border Grid.Column="1"
        Background="#F1F1F1"
        CornerRadius="25"
        Padding="20,12"
        MinWidth="400"
        MaxWidth="1000"
        HorizontalAlignment="Center"
        Opacity="0.85"
        x:Name="SearchBarBorder">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8E8E8" Offset="0"/>
                                    <GradientStop Color="#F5F5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" 
                        Value="{Binding ItemsForeground, ElementName=root}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" 
                          Opacity="0.08" 
                          BlurRadius="12" 
                          ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- TextBox de recherche -->
                    <TextBox Grid.Column="0"
                Text="{Binding SearchText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                BorderThickness="0"
                             x:Name="_SearchTextBox"
                Background="Transparent"
                FontSize="14"
                Foreground="{Binding ItemsForeground, ElementName=root}"
                VerticalAlignment="Center"
                Padding="0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                  Margin="{TemplateBinding Padding}"/>
                                                <TextBlock Text="Rechercher un livre, un auteur..."
                                            IsHitTestVisible="False"
                                            Foreground="#BDBDBD"
                                            FontSize="14"
                                            VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Bouton de recherche -->
                    <items:IconButton x:Name="SearchButton"
                          Grid.Column="1"
                          IconKind="Magnify"
                          IconSize="18"
                          IconColor="White"
                          ButtonColor="{Binding ItemsForeground, ElementName=root}"
                          ButtonWidth="32"
                          ButtonHeight="32"
                          Shape="Circle"
                          Command="{Binding SearchCommand, ElementName=root}"
                          Visibility="{Binding IsSearchButtonVisible, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Bouton changement de vue -->
            <items:IconButton x:Name="SwitchViewModeBtn"
                  Grid.Column="2"
                  IconKind="ViewGridOutline"
                  IconSize="20"
                  IconColor="{Binding ItemsForeground, ElementName=root}"
                  ButtonColor="Transparent"
                  ButtonWidth="40"
                  ButtonHeight="40"
                  Shape="Circle"
                  ToolTip="Changer la vue (Liste/Grille)"
                  Command="{Binding ToggleViewCommand, ElementName=root}"
                  Visibility="{Binding IsToggleViewButtonVisible, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="5,0"/>

            <!-- Menu filtres (visible en mode Grid) -->
            <items:IconButton Grid.Column="3"
                             IconKind="FilterVariant"
                             IconSize="20"
                             IconColor="{Binding ItemsForeground, ElementName=root}"
                             ButtonColor="Transparent"
                             ButtonWidth="40"
                             ButtonHeight="40"
                             Shape="Circle"
                             ToolTip="Filtres et tris"
                             Visibility="{Binding IsGridMode, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="5,0"/>

            <!-- Bouton reload -->
            <items:IconButton x:Name="ReloadButton"
                  Grid.Column="4"
                  IconKind="Refresh"
                  IconSize="20"
                  IconColor="{Binding ItemsForeground, ElementName=root}"
                  ButtonColor="Transparent"
                  ButtonWidth="40"
                  ButtonHeight="40"
                  Shape="Circle"
                  ToolTip="Actualiser"
                  Command="{Binding ReloadCommand, ElementName=root}"
                  Visibility="{Binding IsReloadButtonVisible, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="5,0"/>
        </Grid>
    </Border>
</UserControl>

