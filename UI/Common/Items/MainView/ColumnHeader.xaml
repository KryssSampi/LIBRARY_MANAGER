<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.MainView.ColumnHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Modules/BookCatalog/Views/MainView/style/StyleManager.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- 🟦 BORDURE PRINCIPALE -->
        <Border x:Name="EffectBorder"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="12"
                BorderBrush="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5F5FE"/>
                            <Setter Property="BorderBrush" Value="{Binding Foreground, ElementName=root}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#045C9E" BlurRadius="8" Opacity="0.21" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 🔸 Label principal -->
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderName, ElementName=root}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="{Binding Foreground, ElementName=root}"/>

                <!-- 🔸 Glyph tri ▲▼ -->
                <TextBlock Text="{Binding SortGlyph, ElementName=root}"
                           FontSize="16"
                           Grid.Column="1"
                           Foreground="{Binding Foreground, ElementName=root}"
                           Margin="1"
                           Visibility="{Binding IsSorted, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 🔸 ComboBox filtrage -->
                <ComboBox x:Name="FilterCombo"
                          Width="22"
                          Margin="8,0,0,0"
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{Binding Foreground, ElementName=root}"
                          ItemsSource="{Binding FilterMenuItems, ElementName=root}"
                          Visibility="{Binding AllowFilter, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- ✅ Style du chevron -->
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Name="ToggleButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path x:Name="Arrow"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </ToggleButton>

                                <Popup Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="White"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            BorderBrush="{Binding Foreground, ElementName=root}"
                                            Padding="4"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer Margin="0"
                                                      SnapsToDevicePixels="True"
                                                      Style="{StaticResource ModernScrollViewer}">
                                            <StackPanel IsItemsHost="True" 
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>

                    <!-- ✅ Template des items -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}"
         Padding="6,4"
         Margin="1"
         Background="Transparent"
         BorderBrush="Transparent"
         HorizontalContentAlignment="Stretch"
         Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                     Background="Transparent"
                     CornerRadius="8">
                                            <Grid Margin="4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ✅ CheckBox -->
                                                <CheckBox x:Name="chk"
                               IsChecked="{Binding IsChecked, Mode=TwoWay}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                                                <!-- ✅ Label -->
                                                <TextBlock Text="{Binding Label}"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="Black"/>


                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Clic sur le bouton entier = toggle checkbox -->
                                            <EventTrigger RoutedEvent="Button.Click">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <BooleanAnimationUsingKeyFrames
                                 Storyboard.TargetProperty="(CheckBox.IsChecked)"
                                 Storyboard.TargetName="chk">
                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                        </BooleanAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Séparateur -->
                <Border Width="1"
                        Height="25"
                        BorderThickness="1"
                        BorderBrush="{Binding Foreground, ElementName=root}"
                        Grid.Column="3"
                        Margin="5,0,0,-5"
                        HorizontalAlignment="Right"
                        CornerRadius="10"/>
            </Grid>
        </Border>
    </Grid>
    <UserControl.ContextMenu>
        <ContextMenu x:Name="DynamicFilterMenu"
                 Background="White"
                 BorderBrush="{Binding Foreground, ElementName=root}"
                 BorderThickness="1"
                 Placement="MousePoint"
                 Visibility="{Binding AllowFilter, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ItemsControl ItemsSource="{Binding FilterMenuItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 🔘 Un bouton entier pour chaque option -->
                        <Button Command="{Binding Command}"
                            Padding="6,4"
                            Margin="1"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                        Background="Transparent"
                                        CornerRadius="8">
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ✅ CheckBox -->
                                            <CheckBox x:Name="chk"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>

                                            <!-- ✅ Label -->
                                            <TextBlock Text="{Binding Label}"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="Black"/>

                              
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Clic sur le bouton entier = toggle checkbox -->
                                        <EventTrigger RoutedEvent="Button.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <BooleanAnimationUsingKeyFrames
                                                    Storyboard.TargetProperty="(CheckBox.IsChecked)"
                                                    Storyboard.TargetName="chk">
                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                    </BooleanAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContextMenu>
    </UserControl.ContextMenu>


    <!-- ✅ clic gauche = ouvrir le menu contextuel -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseRightButtonUp">
            <BeginStoryboard>
                <Storyboard>
                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="ContextMenu.IsOpen">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                    </BooleanAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
