<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.MainView.ActiveFiltersLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             mc:Ignorable="d"
             x:Name="root"
             MinHeight="28"
             MinWidth="80">

    <!-- Bordure principale du label -->
    <Border x:Name="LabelBorder"
            Background="{Binding LabelBackground, ElementName=root}"
            CornerRadius="14"
            Margin="0,0,10,0"
            Padding="8,3"
            MaxWidth="300"
            VerticalAlignment="Center"
            BorderBrush="#1976D2"
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Contenu textuel -->
            <StackPanel x:Name="LabelContentPanel" Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock x:Name="TypeTextBlock"
                           Text="{Binding TypeText, ElementName=root}"
                           Foreground="{Binding Foreground, ElementName=root}"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,2,0"/>

                <TextBlock x:Name="ValueTextBlock"
                           Text="{Binding ValueText, ElementName=root}"
                           Foreground="{Binding Foreground, ElementName=root}"
                           FontSize="13"
                           FontWeight="Normal"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Bouton de fermeture -->
            <items:IconButton x:Name="CloseButton"
                              Grid.Column="1"
                              IconKind="Close"
                              IconSize="13"
                              IconColor="Red"
                              ButtonColor="Transparent"
                              ButtonWidth="24"
                              ButtonHeight="24"
                              Shape="Circle"
                              Cursor="Hand"
                              Margin="6,0,0,0"
                              Command="{Binding CloseCommand, ElementName=root}"
                              CommandParameter="{Binding FilterId, ElementName=root}" />
        </Grid>
    </Border>
</UserControl>
