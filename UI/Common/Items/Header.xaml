<UserControl x:Class="LIBBRARY_MANAGER.UI.Common.Items.MainView.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LIBBRARY_MANAGER.UI.Modules.BookCatalog.Items"
             MaxHeight="130"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,9" HorizontalAlignment="Center">
        <Image Width="150"
              Height="150
              " Margin="0,0,20,0"
      Source="{Binding SideImage
            , RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <StackPanel VerticalAlignment="Center">
            <Image Width="300"
                   Height="50
                   " Margin="-10"
           Source="{Binding Logo, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      FontSize="42" 
                      FontWeight="Bold"
                           TextAlignment="Center"
                      Foreground="#1565C0"/>
                <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      FontSize="20" 
                           TextAlignment="Center"
                      Foreground="#757575"
                      Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
</UserControl>
