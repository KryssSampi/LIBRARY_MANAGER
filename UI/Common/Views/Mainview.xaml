<UserControl x:Class="LIBBRARY_MANAGER.UI.Modules.Common.Views.GenericMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items"
             xmlns:localItems="clr-namespace:LIBBRARY_MANAGER.UI.Common.Items.MainView" 
             Background="#FAFAFA">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Style/GlobalStyleManager.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <localItems:Header  
            Grid.Row="0"
            Background="White"
            HorizontalContentAlignment="Center"
            LogoPath="/UI/Common/Assets/BookCatalog_Images/Noctua_Blue.png"
            SideImagePath="/UI/Common/Assets/BookCatalog_Images/Noctua_On_Book.png"
            Title="Gestionnaire de Bibliothèque"
            Subtitle="Explorer Notre Collection"/>

        <Separator Width="2000" Background="{StaticResource DarkBlue}" Grid.Row="1" Height="2"/>

        <!-- Navigation Bar -->
        <!-- Ajout de ToggleViewCommand -->
        <localItems:NavigationBar x:Name="NavigationBar_"
                                  Grid.Row="2"
                                  SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsForeground="{Binding NavigationForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  PanelBackground="White"
                                  BackCommand="{Binding BackCommand}"
                                  SearchCommand="{Binding SearchCommand}"
                                  ToggleViewCommand="{Binding ToggleViewModeCommand}"
                                  ReloadCommand="{Binding ReloadCommand}"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Active Filters -->
                <localItems:ActiveFiltersPanel
                    x:Name="ActiveFiltersPanel_"
                    Grid.Row="0"                              
                    Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Search Results Message -->
                <localItems:SearchResultMessage  
                    x:Name="SearchResultMessage_"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Message="{Binding SearchText}"
                    ResultCount="{Binding TotalResults}"
                    Foreground="{Binding NavigationForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <!-- Content Area avec panneau latéral -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column Headers -->
                    <localItems:ColumnHeadersPanel 
                        Grid.Row="0"
                        Grid.Column="0"
                         Grid.ColumnSpan="2"
                        x:Name="ColumnHeaderPanel_"
                        Foreground="{Binding NavigationForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsListMode="{Binding IsListView}"/>

                    <!-- Items Grid avec ScrollViewer -->
                    <ScrollViewer Grid.Row="1" 
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource ModernScrollViewer}"
                                  MaxHeight="700">
                        <UniformGrid x:Name="ItemsGrid" Columns="1"/>
                    </ScrollViewer>

                    <!-- ✅ PANNEAU LATÉRAL POUR DÉTAILS/EMPRUNT -->
                    <Border Grid.Row="0" 
                            Grid.RowSpan="2"
                            Grid.Column="1" 
                            x:Name="SidePanelBorder"
                            Width="400"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">

                        <ContentControl x:Name="DisplayPanel"/>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <localItems:StatusBar  
            x:Name="StatusBar_"
            Grid.Row="4"
            TotalBooks="{Binding TotalResults}"/>
    </Grid>
</UserControl>